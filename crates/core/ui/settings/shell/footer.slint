import { ChromeIcons } from "../../icons/icons.slint";
import { InkBottomBar } from "../../widgets/ink/bottom_bar.slint";
import { InkMetrics } from "../../widgets/ink/metrics.slint";

export component SettingsFooter inherits Rectangle {
    in-out property <int> page;
    in property <int> page-count;
    in property <bool> show-action;
    callback action-pressed();

    // The bar is always on screen. Its height is reserved before the
    // button list exists. Reading a live min height loops: the pager
    // depends on this height.
    out property <length> bar-height: InkMetrics.bottom-bar;
    height: root.bar-height;

    InkBottomBar {
        width: 100%;
        height: 100%;
        label: "\{root.page + 1} / \{root.page-count}";
        previous-icon: ChromeIcons.chevron-backward;
        previous-enabled: root.page > 0;
        next-icon: ChromeIcons.chevron-forward;
        next-enabled: root.page + 1 < root.page-count;
        show-action: root.show-action;
        action-icon: ChromeIcons.add;

        previous-clicked => {
            if (root.page > 0) {
                root.page -= 1;
            }
        }
        next-clicked => {
            if (root.page + 1 < root.page-count) {
                root.page += 1;
            }
        }
        action-clicked => {
            root.action-pressed();
        }
    }
}

import { SettingsCategory } from "../setting_line.slint";
import { DictionaryPage } from "../categories/dictionaries.slint";
import { LibraryPage } from "../categories/libraries.slint";
import { SettingsPage } from "../categories/settings_page.slint";

// Switches the visible category. Static categories share SettingsPage.
// Libraries and dictionaries keep their own models.
//
// The window stretches this region so the footer stays on the bottom edge.
// `start` keeps each row at its own height. The default `stretch` caps the
// region at the rows' height, and the leftover space then enlarges the app bar.
export component SettingsPages inherits VerticalLayout {
    alignment: start;
    in property <SettingsCategory> category;
    in property <int> page;
    in property <int> per-page;

    if root.category == SettingsCategory.dictionaries: DictionaryPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.libraries: LibraryPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category != SettingsCategory.dictionaries && root.category != SettingsCategory.libraries: SettingsPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }
}

import { SettingsCategory } from "../setting_line.slint";
import { DictionaryPage } from "../categories/dictionaries.slint";
import { GeneralPage } from "../categories/general.slint";
import { ImportPage } from "../categories/import.slint";
import { IntermissionPage } from "../categories/intermission.slint";
import { LibraryPage } from "../categories/libraries.slint";
import { PowerPage } from "../categories/power.slint";
import { ReaderPage } from "../categories/reader.slint";
import { TelemetryPage } from "../categories/telemetry.slint";

// Switches the visible category. Each page reads its own global for values
// and callbacks. This shell only passes the shared page window.
//
// The window stretches this region so the footer stays on the bottom edge.
// `start` keeps each row at its own height. The default `stretch` caps the
// region at the rows' height, and the leftover space then enlarges the app bar.
export component SettingsPages inherits VerticalLayout {
    alignment: start;
    in property <SettingsCategory> category;
    in property <int> page;
    in property <int> per-page;

    if root.category == SettingsCategory.general : GeneralPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.power : PowerPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.reader : ReaderPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.dictionaries : DictionaryPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.libraries : LibraryPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.intermissions : IntermissionPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.import : ImportPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }

    if root.category == SettingsCategory.telemetry : TelemetryPage {
        vertical-stretch: 1;
        page: root.page;
        per-page: root.per-page;
    }
}

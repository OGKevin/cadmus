// Screen size the settings shell and its overlays share.
// Rust sets this from the device framebuffer, in logical pixels
// (`physical * 300 / dpi`). Category pages do not. These are not dp:
// a dp would not match the framebuffer.
export global SettingsChrome {
    in property <length> window-width: 1072px;
    in property <length> window-height: 1448px;
}

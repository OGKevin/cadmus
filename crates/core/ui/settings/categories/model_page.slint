import { PagedSetting } from "paged_row.slint";
import { SettingLine } from "../setting_line.slint";

export component ModelPage inherits VerticalLayout {
    in property <[SettingLine]> rows;
    in property <int> page;
    in property <int> per-page;
    callback row-pressed(int);
    callback row-held(int);

    for line[index] in root.rows: PagedSetting {
        slot: index;
        page: root.page;
        per-page: root.per-page;
        label: line.label;
        value: line.value;
        pressed => {
            root.row-pressed(index);
        }
        held => {
            root.row-held(index);
        }
    }
}

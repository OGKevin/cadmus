import { PagedSetting } from "paged_row.slint";
import { SettingRow, StaticLine } from "../setting_line.slint";

// A category page driven by a model, the same way `ModelPage` lists
// libraries. The slot is the model index. Rust supplies the label from
// Fluent, so the row text is not also an `@tr` string.
export component StaticPage inherits VerticalLayout {
    in property <[StaticLine]> rows;
    in property <int> page;
    in property <int> per-page;
    callback row-pressed(SettingRow);

    for line[index] in root.rows: PagedSetting {
        slot: index;
        page: root.page;
        per-page: root.per-page;
        label: line.label;
        value: line.value;
        pressed => {
            root.row-pressed(line.row);
        }
    }
}

import { PagedSetting } from "paged_row.slint";
import { SettingRow } from "../setting_line.slint";

// Power's values and row callback. Rust sets these; the window does not.
export global PowerPageIo {
    in property <bool> show-soft-suspend: false;
    out property <int> row-count: 3 + (show-soft-suspend ? 3 : 0);
    in property <string> autosleep-mode;
    in property <string> indicate-autosleep-led;
    in property <string> autosleep-grace;
    in property <string> auto-suspend;
    in property <string> auto-power-off;
    in property <string> sleep-cover;
    callback row-pressed(SettingRow);
}

export component PowerPage inherits VerticalLayout {
    in property <int> page;
    in property <int> per-page;
    property <int> soft-count: PowerPageIo.show-soft-suspend ? 3 : 0;

    PagedSetting {
        shown: PowerPageIo.show-soft-suspend;
        slot: 0;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Soft Suspend");
        value: PowerPageIo.autosleep-mode;
        pressed => { PowerPageIo.row-pressed(SettingRow.autosleep-mode); }
    }

    PagedSetting {
        shown: PowerPageIo.show-soft-suspend;
        slot: 1;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Use LED to Indicate Soft Suspend");
        value: PowerPageIo.indicate-autosleep-led;
        pressed => { PowerPageIo.row-pressed(SettingRow.indicate-autosleep-led); }
    }

    PagedSetting {
        shown: PowerPageIo.show-soft-suspend;
        slot: 2;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Soft Suspend Release Grace (seconds)");
        value: PowerPageIo.autosleep-grace;
        pressed => { PowerPageIo.row-pressed(SettingRow.autosleep-grace); }
    }

    PagedSetting {
        slot: root.soft-count;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Auto Suspend (minutes)");
        value: PowerPageIo.auto-suspend;
        pressed => { PowerPageIo.row-pressed(SettingRow.auto-suspend); }
    }

    PagedSetting {
        slot: root.soft-count + 1;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Auto Power Off (days)");
        value: PowerPageIo.auto-power-off;
        pressed => { PowerPageIo.row-pressed(SettingRow.auto-power-off); }
    }

    PagedSetting {
        slot: root.soft-count + 2;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Enable Sleep Cover");
        value: PowerPageIo.sleep-cover;
        pressed => { PowerPageIo.row-pressed(SettingRow.sleep-cover); }
    }
}

import { StaticPage } from "static_page.slint";
import { SettingRow, StaticLine } from "../setting_line.slint";

// Power's rows and row callback. Rust omits the soft-suspend rows when the
// device has none, so the page does not reserve empty slots for them.
export global PowerPageIo {
    in property <[StaticLine]> rows;
    out property <int> row-count: rows.length;
    callback row-pressed(SettingRow);
}

export component PowerPage inherits VerticalLayout {
    in property <int> page;
    in property <int> per-page;

    StaticPage {
        vertical-stretch: 1;
        rows: PowerPageIo.rows;
        page: root.page;
        per-page: root.per-page;
        row-pressed(row) => {
            PowerPageIo.row-pressed(row);
        }
    }
}

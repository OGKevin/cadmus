import { PagedSetting } from "paged_row.slint";
import { SettingRow } from "../setting_line.slint";

// General's values and row callback. Rust sets these; the window does not.
export global GeneralPageIo {
    out property <int> row-count: 13;
    in property <string> locale;
    in property <string> auto-share;
    in property <string> auto-time;
    in property <string> ntp-server;
    in property <string> auto-frontlight;
    in property <string> auto-frontlight-brightness;
    in property <string> auto-frontlight-manual-coordinates;
    in property <string> wifi-idle-timeout;
    in property <string> button-scheme;
    in property <string> keyboard-layout;
    in property <string> settings-retention;
    in property <string> db-backup-retention;
    in property <string> startup-mode;
    callback row-pressed(SettingRow);
}

export component GeneralPage inherits VerticalLayout {
    in property <int> page;
    in property <int> per-page;

    PagedSetting {
        slot: 0;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Language");
        value: GeneralPageIo.locale;
        pressed => { GeneralPageIo.row-pressed(SettingRow.locale); }
    }

    PagedSetting {
        slot: 1;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Enable Auto Share");
        value: GeneralPageIo.auto-share;
        pressed => { GeneralPageIo.row-pressed(SettingRow.auto-share); }
    }

    PagedSetting {
        slot: 2;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Automatic Time Sync");
        value: GeneralPageIo.auto-time;
        pressed => { GeneralPageIo.row-pressed(SettingRow.auto-time); }
    }

    PagedSetting {
        slot: 3;
        page: root.page;
        per-page: root.per-page;
        label: @tr("NTP Server");
        value: GeneralPageIo.ntp-server;
        pressed => { GeneralPageIo.row-pressed(SettingRow.ntp-server); }
    }

    PagedSetting {
        slot: 4;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Automatic Frontlight");
        value: GeneralPageIo.auto-frontlight;
        pressed => { GeneralPageIo.row-pressed(SettingRow.auto-frontlight); }
    }

    PagedSetting {
        slot: 5;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Auto Night Brightness");
        value: GeneralPageIo.auto-frontlight-brightness;
        pressed => { GeneralPageIo.row-pressed(SettingRow.auto-frontlight-brightness); }
    }

    PagedSetting {
        slot: 6;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Manual Coordinates");
        value: GeneralPageIo.auto-frontlight-manual-coordinates;
        pressed => { GeneralPageIo.row-pressed(SettingRow.auto-frontlight-manual-coordinates); }
    }

    PagedSetting {
        slot: 7;
        page: root.page;
        per-page: root.per-page;
        label: @tr("WiFi Idle Timeout (minutes)");
        value: GeneralPageIo.wifi-idle-timeout;
        pressed => { GeneralPageIo.row-pressed(SettingRow.wifi-idle-timeout); }
    }

    PagedSetting {
        slot: 8;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Button Scheme");
        value: GeneralPageIo.button-scheme;
        pressed => { GeneralPageIo.row-pressed(SettingRow.button-scheme); }
    }

    PagedSetting {
        slot: 9;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Keyboard Layout");
        value: GeneralPageIo.keyboard-layout;
        pressed => { GeneralPageIo.row-pressed(SettingRow.keyboard-layout); }
    }

    PagedSetting {
        slot: 10;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Settings Retention");
        value: GeneralPageIo.settings-retention;
        pressed => { GeneralPageIo.row-pressed(SettingRow.settings-retention); }
    }

    PagedSetting {
        slot: 11;
        page: root.page;
        per-page: root.per-page;
        label: @tr("DB Backup Retention");
        value: GeneralPageIo.db-backup-retention;
        pressed => { GeneralPageIo.row-pressed(SettingRow.db-backup-retention); }
    }

    PagedSetting {
        slot: 12;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Startup Mode");
        value: GeneralPageIo.startup-mode;
        pressed => { GeneralPageIo.row-pressed(SettingRow.startup-mode); }
    }
}

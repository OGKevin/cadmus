import { StaticPage } from "static_page.slint";
import { SettingRow, StaticLine } from "../setting_line.slint";

// General's rows and row callback. Rust sets the model; the window does not.
export global GeneralPageIo {
    in property <[StaticLine]> rows;
    out property <int> row-count: rows.length;
    callback row-pressed(SettingRow);
}

export component GeneralPage inherits VerticalLayout {
    in property <int> page;
    in property <int> per-page;

    StaticPage {
        vertical-stretch: 1;
        rows: GeneralPageIo.rows;
        page: root.page;
        per-page: root.per-page;
        row-pressed(row) => {
            GeneralPageIo.row-pressed(row);
        }
    }
}

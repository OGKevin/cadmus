import { PagedSetting } from "paged_row.slint";
import { SettingRow } from "../setting_line.slint";

// Telemetry's values and row callback. Rust sets these; the window does not.
// `row-count` matches the visible slots below.
export global TelemetryPageIo {
    in property <bool> show-otlp: false;
    in property <bool> show-pyroscope: false;
    in property <bool> show-kern-log: false;
    in property <bool> show-dbus-log: false;
    out property <int> row-count: 2
        + (show-otlp ? 1 : 0)
        + (show-pyroscope ? 1 : 0)
        + (show-kern-log ? 1 : 0)
        + (show-dbus-log ? 1 : 0);
    in property <string> logging-enabled;
    in property <string> log-level;
    in property <string> otlp-endpoint;
    in property <string> pyroscope-endpoint;
    in property <string> enable-kern-log;
    in property <string> enable-dbus-log;
    callback row-pressed(SettingRow);
}

export component TelemetryPage inherits VerticalLayout {
    in property <int> page;
    in property <int> per-page;
    property <int> pyro-slot: 2 + (TelemetryPageIo.show-otlp ? 1 : 0);
    property <int> kern-slot: root.pyro-slot + (TelemetryPageIo.show-pyroscope ? 1 : 0);
    property <int> dbus-slot: root.kern-slot + (TelemetryPageIo.show-kern-log ? 1 : 0);

    PagedSetting {
        slot: 0;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Enable Logging");
        value: TelemetryPageIo.logging-enabled;
        pressed => { TelemetryPageIo.row-pressed(SettingRow.logging-enabled); }
    }

    PagedSetting {
        slot: 1;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Log Level");
        value: TelemetryPageIo.log-level;
        pressed => { TelemetryPageIo.row-pressed(SettingRow.log-level); }
    }

    PagedSetting {
        shown: TelemetryPageIo.show-otlp;
        slot: 2;
        page: root.page;
        per-page: root.per-page;
        label: @tr("OTLP Endpoint");
        value: TelemetryPageIo.otlp-endpoint;
        pressed => { TelemetryPageIo.row-pressed(SettingRow.otlp-endpoint); }
    }

    PagedSetting {
        shown: TelemetryPageIo.show-pyroscope;
        slot: root.pyro-slot;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Pyroscope Endpoint");
        value: TelemetryPageIo.pyroscope-endpoint;
        pressed => { TelemetryPageIo.row-pressed(SettingRow.pyroscope-endpoint); }
    }

    PagedSetting {
        shown: TelemetryPageIo.show-kern-log;
        slot: root.kern-slot;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Enable Kernel Log");
        value: TelemetryPageIo.enable-kern-log;
        pressed => { TelemetryPageIo.row-pressed(SettingRow.enable-kern-log); }
    }

    PagedSetting {
        shown: TelemetryPageIo.show-dbus-log;
        slot: root.dbus-slot;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Enable D-Bus Log");
        value: TelemetryPageIo.enable-dbus-log;
        pressed => { TelemetryPageIo.row-pressed(SettingRow.enable-dbus-log); }
    }
}

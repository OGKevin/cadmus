import { PagedSetting } from "paged_row.slint";
import { SettingRow } from "../setting_line.slint";

// Import's values and row callback. Rust sets these; the window does not.
export global ImportPageIo {
    out property <int> row-count: 3;
    in property <string> force-full-import;
    in property <string> sync-metadata;
    in property <string> allowed-kinds;
    callback row-pressed(SettingRow);
}

export component ImportPage inherits VerticalLayout {
    in property <int> page;
    in property <int> per-page;

    PagedSetting {
        slot: 0;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Force Full Import");
        value: ImportPageIo.force-full-import;
        pressed => { ImportPageIo.row-pressed(SettingRow.force-full-import); }
    }

    PagedSetting {
        slot: 1;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Sync Metadata");
        value: ImportPageIo.sync-metadata;
        pressed => { ImportPageIo.row-pressed(SettingRow.import-sync-metadata); }
    }

    PagedSetting {
        slot: 2;
        page: root.page;
        per-page: root.per-page;
        label: @tr("Indexed File Types");
        value: ImportPageIo.allowed-kinds;
        pressed => { ImportPageIo.row-pressed(SettingRow.allowed-kinds); }
    }
}

import { ChromeIcons } from "../icons/icons.slint";
import { PagedLine, PagedList } from "../widgets/paged_list.slint";
import { DictionaryPageIo } from "./categories/dictionaries.slint";
import { LibraryPageIo } from "./categories/libraries.slint";
import { StaticPageIo } from "./categories/settings_page.slint";
import {
    ChoiceSheetIo,
    ConfirmSheetIo,
    FileBrowserIo,
    SharedOverlays,
    TextSheetIo,
} from "../widgets/overlays.slint";
import { LibraryEditor, LibraryEditorIo } from "./editors/library_editor.slint";
import { RefreshRates, RefreshRatesIo } from "./editors/refresh_rates.slint";
import { InkMetrics } from "../widgets/ink/metrics.slint";
import { InkScreen } from "../widgets/ink/screen.slint";
import { MaterialPalette } from "../widgets/ink/palette.slint";
import { InkScaffold } from "../widgets/ink/scaffold.slint";
import { InkWindow } from "../widgets/ink/window.slint";
import { Hairline } from "../widgets/hairline.slint";
import { CategoryBar } from "shell/category_bar.slint";
import { SettingsCategory } from "./category.slint";

export {
    SettingsCategory,
    StaticPageIo,
    DictionaryPageIo,
    LibraryPageIo,
    LibraryEditorIo,
    RefreshRatesIo,
}

// Shell only: category, page, and the three chrome callbacks.
// Each category and overlay lists its own values and callbacks on its global.
export component SettingsWindow inherits InkWindow {
    in-out property <SettingsCategory> category: SettingsCategory.general;
    in-out property <int> page: 0;

    callback back-pressed();
    callback category-pressed(SettingsCategory);
    callback action-pressed();

    property <bool> show-action: root.category == SettingsCategory.libraries;
    // The rows of the visible category. Libraries and dictionaries publish
    // their own rows; the other categories share the static rows.
    property <[PagedLine]> lines:
        root.category == SettingsCategory.libraries ? LibraryPageIo.rows :
        root.category == SettingsCategory.dictionaries ? DictionaryPageIo.rows :
        StaticPageIo.rows;
    // The height above the list: the app bar, the rule under it, the
    // category bar, and the rule under that.
    out property <length> list-top: scaffold.chrome-height + category-bar.bar-height + InkMetrics.hairline;
    // The height the list may use.
    out property <length> available-height: InkScreen.window-height - root.list-top;

    changed category => {
        root.page = 0;
    }

    function press-row(index: int) {
        if (root.category == SettingsCategory.libraries) {
            LibraryPageIo.row-pressed(index);
        } else if (root.category == SettingsCategory.dictionaries) {
            DictionaryPageIo.row-pressed(index);
        } else {
            StaticPageIo.row-pressed(index);
        }
    }

    scaffold := InkScaffold {
        width: 100%;
        height: 100%;
        title: @tr("Settings");
        back-pressed => {
            root.back-pressed();
        }

        category-bar := CategoryBar {
            category <=> root.category;
            category-pressed(category) => {
                root.category-pressed(category);
            }
        }

        Hairline {
            line-color: MaterialPalette.outline;
        }

        PagedList {
            vertical-stretch: 1;
            lines: root.lines;
            available-height: root.available-height;
            holdable: root.category == SettingsCategory.libraries;
            show-action: root.show-action;
            action-icon: ChromeIcons.add;
            page <=> root.page;
            line-pressed(index) => {
                root.press-row(index);
            }
            line-held(index) => {
                if (root.category == SettingsCategory.libraries) {
                    LibraryPageIo.row-held(index);
                }
            }
            action-clicked => {
                root.action-pressed();
            }
        }
    }

    if LibraryEditorIo.open: LibraryEditor {}
    if RefreshRatesIo.open: RefreshRates {}
    SharedOverlays {}
}

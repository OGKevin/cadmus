import { ChromeIcons } from "../../icons/icons.slint";
import { Hairline } from "../hairline.slint";
import { MaterialPalette } from "palette.slint";
import { InkAppBar } from "app_bar.slint";
import { InkMetrics } from "metrics.slint";

// App bar, hairline, then the screen body. Use-site children go between
// the hairline and the bottom of the body.

export component InkScaffold inherits Rectangle {
    in property <string> title;
    in property <bool> back-enabled: true;
    callback back-pressed();

    property <image> no-icon;
    background: MaterialPalette.surface;

    // The chrome the scaffold puts above the body. A screen that fills the
    // window leaves the rest of the height to its body.
    out property <length> chrome-height: InkMetrics.app-bar + InkMetrics.hairline;

    VerticalLayout {
        width: 100%;
        height: 100%;

        InkAppBar {
            title: root.title;
            leading-icon: root.back-enabled ? ChromeIcons.arrow_back : root.no-icon;
            leading-clicked => {
                if (root.back-enabled) {
                    root.back-pressed();
                }
            }
        }

        Hairline {
            line-color: MaterialPalette.outline;
        }

        @children
    }
}

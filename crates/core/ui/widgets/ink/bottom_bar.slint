import { InkIconButton } from "icon_button.slint";
import { MaterialPalette } from "palette.slint";
import { InkMetrics } from "metrics.slint";

// Bottom bar: previous on the left, next on the right, page label in the
// middle. An optional action sits inside the right corner. The bar is
// always present; disabled arrows stay in place when there is one page.

export component InkBottomBar inherits Rectangle {
    in property <bool> previous-enabled: true;
    in property <image> previous-icon;
    in property <bool> next-enabled: true;
    in property <image> next-icon;
    in property <string> label;
    in property <bool> show-action;
    in property <image> action-icon;
    callback previous-clicked();
    callback next-clicked();
    callback action-clicked();

    background: MaterialPalette.bar;

    HorizontalLayout {
        VerticalLayout {
            width: InkMetrics.icon-button;
            alignment: center;

            InkIconButton {
                icon: root.previous-icon;
                enabled: root.previous-enabled;
                clicked => {
                    root.previous-clicked();
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.show-action: VerticalLayout {
            width: InkMetrics.fab;
            alignment: center;

            Rectangle {
                width: InkMetrics.fab;
                height: self.width;
                border-radius: self.width / 2;
                background: MaterialPalette.primary;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: InkMetrics.icon;
                    height: self.width;
                    source: root.action-icon;
                    colorize: MaterialPalette.on-primary;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.action-clicked();
                    }
                }
            }
        }

        VerticalLayout {
            width: InkMetrics.icon-button;
            alignment: center;

            InkIconButton {
                icon: root.next-icon;
                enabled: root.next-enabled;
                clicked => {
                    root.next-clicked();
                }
            }
        }
    }

    if root.label != "": Text {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: InkMetrics.bar-label;
        font-weight: InkMetrics.label-weight;
        color: MaterialPalette.on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

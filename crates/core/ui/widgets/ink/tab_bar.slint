import { MaterialPalette } from "palette.slint";
import { InkMetrics } from "metrics.slint";

component InkTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    min-height: InkMetrics.tab-row;
    background: MaterialPalette.surface;

    VerticalLayout {
        padding-left: InkMetrics.tab-pad-x;
        padding-right: self.padding-left;
        padding-top: InkMetrics.tab-pad-top;
        padding-bottom: InkMetrics.tab-pad-bottom;
        alignment: center;

        label := Text {
            text: root.text;
            font-size: InkMetrics.tab-label;
            font-weight: 400;
            color: MaterialPalette.on-surface;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        x: (parent.width - label.width) / 2;
        y: parent.height - self.height;
        width: label.width;
        height: InkMetrics.indicator;
        background: MaterialPalette.primary;
        visible: root.selected;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

// Primary tabs. Labels wrap onto the next row. The selected label carries
// an underline; nothing moves, and a press does not paint a second state.

export component InkTabBar inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current-index: 0;
    callback index-changed(index: int);

    min-height: max(InkMetrics.tab-row, layout.min-height);
    background: MaterialPalette.surface;

    layout := FlexboxLayout {
        width: 100%;
        flex-wrap: wrap;
        flex-direction: row;
        alignment: start;

        for label[index] in root.labels: InkTab {
            text: label;
            selected: index == root.current-index;
            clicked => {
                root.current-index = index;
                root.index-changed(index);
            }
        }
    }
}

import { ChromeIcons } from "../icons/icons.slint";
import { Hairline } from "hairline.slint";
import { InkBottomBar } from "ink/bottom_bar.slint";
import { InkMetrics } from "ink/metrics.slint";
import { MaterialPalette } from "ink/palette.slint";
import { Paging } from "paging.slint";

// One row of the option list. `checked` marks the current value on a
// single-choice list, or one toggled option on a checkbox list.
export struct ChoiceEntry {
    label: string,
    checked: bool,
}

// A modal that lists options: a title on top, the entries beneath, the
// current value checked, the same picker Nickel opens for a format. A list
// longer than the dialog is split into pages. The bottom bar and `page`
// move one whole page at a time; the sheet does not follow a finger.
// `entry-pressed` passes the index into `entries`, starting at 0.
export component ChoiceSheet inherits Rectangle {
    in property <string> title;
    in property <[ChoiceEntry]> entries;
    in-out property <int> page: 0;
    callback dismissed();
    callback entry-pressed(int);

    width: 100%;
    height: 100%;

    // Fixed so the page size does not depend on a measured layout.
    property <length> row-height: 48px * InkMetrics.dp;
    property <length> title-height: 26px * InkMetrics.dp;
    property <length> inset: 21px * InkMetrics.dp;
    property <length> gap: 16px * InkMetrics.dp;
    property <length> frame: InkMetrics.frame;
    property <length> dialog-max: root.height - 2 * root.inset;
    // The border sits inside the dialog, so the rows share what is left of it.
    property <length> content-max: root.dialog-max - 2 * root.frame;
    // Room for rows when every entry is on one page, and when the bar is showing.
    property <length> room-plain: root.content-max - 2 * root.inset - root.title-height - root.gap;
    property <length> room-paged: root.content-max - root.inset - root.title-height - root.gap - InkMetrics.hairline - InkMetrics.bottom-bar;
    property <int> fit-plain: Math.max(1, Math.floor(root.room-plain / root.row-height));
    property <int> fit-paged: Math.max(1, Math.floor(root.room-paged / root.row-height));
    property <bool> paged: root.entries.length > root.fit-plain;
    property <int> per-page: root.paged ? root.fit-paged : Math.max(1, root.entries.length);

    paging := Paging {
        count: root.entries.length;
        per-page: root.per-page;
        page <=> root.page;
    }

    // A tap outside the dialog closes it. The page underneath stays.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismissed();
        }
    }

    VerticalLayout {
        // Center the dialog on the screen.
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: min(parent.width, root.width * 2 / 3);
                max-height: root.dialog-max;
                background: MaterialPalette.surface;
                border-width: root.frame;
                border-radius: InkMetrics.radius;
                border-color: MaterialPalette.on-surface;
                clip: true;

                // The dialog itself swallows taps, so only the backdrop
                // closes it.
                TouchArea {
                    width: 100%;
                    height: 100%;
                }

                VerticalLayout {
                    width: 100%;

                    VerticalLayout {
                        width: 100%;
                        padding-left: root.inset;
                        padding-right: root.inset;
                        padding-top: root.inset;
                        padding-bottom: root.paged ? 0px : root.inset;
                        spacing: root.gap;

                        Text {
                            height: root.title-height;
                            text: root.title;
                            font-size: 20px * InkMetrics.dp;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        VerticalLayout {
                            height: (root.paged ? root.per-page : root.entries.length) * root.row-height;
                            alignment: start;

                            // Only the visible page gets a row.
                            for entry[index] in root.entries: Rectangle {
                                property <bool> shown:
                                    index >= paging.shown-page * paging.per-page
                                    && index < (paging.shown-page + 1) * paging.per-page;
                                height: shown ? root.row-height : 0px;

                                if shown: TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.entry-pressed(index);
                                    }

                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        spacing: 6px * InkMetrics.dp;

                                        // The mark stays in the row when nothing
                                        // is checked, so labels share a left edge.
                                        Rectangle {
                                            width: InkMetrics.mark;
                                            height: InkMetrics.mark;
                                            border-radius: InkMetrics.mark-radius;
                                            background: entry.checked ? MaterialPalette.primary : transparent;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: entry.label;
                                            font-size: InkMetrics.body;
                                            color: MaterialPalette.on-surface;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.paged: Hairline {
                        width: 100%;
                        line-color: MaterialPalette.outline;
                    }

                    if root.paged: InkBottomBar {
                        width: 100%;
                        height: InkMetrics.bottom-bar;
                        label: "\{paging.shown-page + 1} / \{paging.page-count}";
                        previous-icon: ChromeIcons.chevron-backward;
                        previous-enabled: paging.shown-page > 0;
                        next-icon: ChromeIcons.chevron-forward;
                        next-enabled: paging.shown-page + 1 < paging.page-count;
                        previous-clicked => {
                            paging.page = paging.shown-page - 1;
                        }
                        next-clicked => {
                            paging.page = paging.shown-page + 1;
                        }
                    }
                }
            }
        }
    }
}

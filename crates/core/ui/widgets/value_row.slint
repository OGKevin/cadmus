import { Hairline } from "hairline.slint";
import { HoldTouch } from "hold_touch.slint";
import { InkMetrics } from "ink/metrics.slint";
import { MaterialPalette } from "ink/palette.slint";

export component ValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> holdable: false;
    callback pressed();
    callback held();

    height: InkMetrics.row;

    HorizontalLayout {
        height: 100%;
        padding-left: 16px * InkMetrics.dp;
        padding-right: 16px * InkMetrics.dp;
        spacing: 11px * InkMetrics.dp;

        Text {
            text: root.label;
            font-size: InkMetrics.body;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.value;
            font-size: InkMetrics.body;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
            width: root.value == "" ? 0% : 55%;
        }
    }

    Hairline {
        y: parent.height - self.height;
        width: 100%;
        line-color: MaterialPalette.divider;
    }

    HoldTouch {
        width: 100%;
        height: 100%;
        holdable: root.holdable;
        tapped => {
            root.pressed();
        }
        held => {
            root.held();
        }
    }
}

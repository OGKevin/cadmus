import { Hairline } from "hairline.slint";
import { MaterialPalette } from "ink/palette.slint";

// The hold timer starts stopped. A Slint timer runs by default, and one
// left running calls `held` on the next pump, which is the next tap.
// `restart` does nothing while the timer is stopped.
export component ValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback pressed();
    callback held();

    property <bool> suppress-click: false;
    height: 121px;

    hold-timer := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            hold-timer.stop();
            root.suppress-click = true;
            root.held();
        }
    }

    HorizontalLayout {
        height: 100%;
        padding-left: 30px;
        padding-right: 30px;
        spacing: 20px;

        Text {
            text: root.label;
            font-size: 34px;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.value;
            font-size: 34px;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
            width: root.value == "" ? 0% : 55%;
        }
    }

    Hairline {
        y: parent.height - 2px;
        width: 100%;
        line-color: MaterialPalette.divider;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.suppress-click = false;
                if (hold-timer.running) {
                    hold-timer.restart();
                } else {
                    hold-timer.running = true;
                }
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                hold-timer.stop();
            }
        }
        clicked => {
            if (!root.suppress-click) {
                root.pressed();
            }
            root.suppress-click = false;
        }
    }
}

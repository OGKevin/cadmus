import { ChromeIcons } from "../icons/icons.slint";
import { Hairline } from "hairline.slint";
import { InkBottomBar } from "ink/bottom_bar.slint";
import { InkMetrics } from "ink/metrics.slint";
import { MaterialPalette } from "ink/palette.slint";

export struct PagedLine {
    label: string,
    value: string,
    selected: bool,
}

// One choice or file row. The selected row keeps black text and adds a
// dot, colored only when the panel can show it. A press does not paint
// a second state. The hold timer starts stopped. A Slint timer runs by
// default, and one left running calls `held` on the next pump. `restart`
// does nothing while the timer is stopped. One hold per press: a timer
// repeats until stopped.
component InkListRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    callback pressed();
    callback held();

    property <bool> suppress-click: false;
    height: 121px;
    background: MaterialPalette.surface;

    hold-timer := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            hold-timer.stop();
            root.suppress-click = true;
            root.held();
        }
    }

    HorizontalLayout {
        height: 100%;
        padding-left: 16px * InkMetrics.dp;
        padding-right: self.padding-left;
        spacing: 16px;

        Text {
            text: root.label;
            font-size: 16px * InkMetrics.dp;
            font-weight: root.selected ? InkMetrics.label-weight : 400;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.value != "": Text {
            text: root.value;
            font-size: 16px * InkMetrics.dp;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        if root.selected: VerticalLayout {
            width: InkMetrics.indicator;
            alignment: center;

            Rectangle {
                width: InkMetrics.indicator;
                height: self.width;
                border-radius: self.width / 2;
                background: MaterialPalette.primary;
            }
        }
    }

    Hairline {
        y: parent.height - self.height;
        width: 100%;
        line-color: MaterialPalette.outline;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.suppress-click = false;
                if (hold-timer.running) {
                    hold-timer.restart();
                } else {
                    hold-timer.running = true;
                }
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                hold-timer.stop();
            }
        }
        clicked => {
            if (!root.suppress-click) {
                root.pressed();
            }
            root.suppress-click = false;
        }
    }
}

// One page of rows, with the bottom bar always on the screen edge. Page
// buttons are LeftArrow and RightArrow, which is what the device forward
// and back buttons send. Only the visible page gets a row. A hidden row
// would still build its text, rule, and hold timer.
export component PagedList inherits FocusScope {
    in property <[PagedLine]> lines;
    in property <int> per-page: 1;
    in-out property <int> page: 0;
    in property <bool> show-action: false;
    callback line-pressed(int);
    callback line-held(int);
    callback action-clicked();

    vertical-stretch: 1;
    property <int> page-size: Math.max(1, root.per-page);
    property <int> page-count: Math.max(1, Math.ceil(root.lines.length * 1.0 / root.page-size));

    changed page-count => {
        if (root.page >= root.page-count) {
            root.page = Math.max(0, root.page-count - 1);
        }
    }
    changed page => {
        if (root.page < 0) {
            root.page = 0;
        } else if (root.page >= root.page-count) {
            root.page = Math.max(0, root.page-count - 1);
        }
    }

    init => {
        root.focus();
    }

    key-pressed(event) => {
        if (event.text == Key.RightArrow) {
            if (root.page + 1 < root.page-count) {
                root.page += 1;
            }
            accept
        } else if (event.text == Key.LeftArrow) {
            if (root.page > 0) {
                root.page -= 1;
            }
            accept
        } else {
            reject
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;

            for line[index] in root.lines: Rectangle {
                property <bool> shown:
                    index >= root.page * root.page-size && index < (root.page + 1) * root.page-size;
                height: shown ? 121px : 0px;

                if shown: InkListRow {
                    width: 100%;
                    height: 100%;
                    label: line.label;
                    value: line.value;
                    selected: line.selected;
                    pressed => {
                        root.line-pressed(index);
                    }
                    held => {
                        root.line-held(index);
                    }
                }
            }
        }

        InkBottomBar {
            height: InkMetrics.bottom-bar;
            label: "\{root.page + 1} / \{root.page-count}";
            previous-icon: ChromeIcons.chevron-backward;
            previous-enabled: root.page > 0;
            next-icon: ChromeIcons.chevron-forward;
            next-enabled: root.page + 1 < root.page-count;
            show-action: root.show-action;
            action-icon: ChromeIcons.add;
            previous-clicked => {
                if (root.page > 0) {
                    root.page -= 1;
                }
            }
            next-clicked => {
                if (root.page + 1 < root.page-count) {
                    root.page += 1;
                }
            }
            action-clicked => {
                root.action-clicked();
            }
        }
    }
}

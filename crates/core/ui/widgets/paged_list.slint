import { ChromeIcons } from "../icons/icons.slint";
import { Hairline } from "hairline.slint";
import { HoldTouch } from "hold_touch.slint";
import { InkBottomBar } from "ink/bottom_bar.slint";
import { InkMetrics } from "ink/metrics.slint";
import { MaterialPalette } from "ink/palette.slint";

export struct PagedLine {
    label: string,
    value: string,
    selected: bool,
}

// One choice or file row. The selected row keeps black text and adds a
// dot, colored only when the panel can show it. A press does not paint
// a second state. Hold is off unless the list says the row has one.
component InkListRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    in property <bool> holdable: false;
    callback pressed();
    callback held();

    height: InkMetrics.row;
    background: MaterialPalette.surface;

    HorizontalLayout {
        height: 100%;
        padding-left: 16px * InkMetrics.dp;
        padding-right: self.padding-left;
        spacing: 9px * InkMetrics.dp;

        Text {
            text: root.label;
            font-size: 16px * InkMetrics.dp;
            font-weight: root.selected ? InkMetrics.label-weight : 400;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.value != "": Text {
            text: root.value;
            font-size: 16px * InkMetrics.dp;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        if root.selected: VerticalLayout {
            width: InkMetrics.indicator;
            alignment: center;

            Rectangle {
                width: InkMetrics.indicator;
                height: self.width;
                border-radius: self.width / 2;
                background: MaterialPalette.primary;
            }
        }
    }

    Hairline {
        y: parent.height - self.height;
        width: 100%;
        line-color: MaterialPalette.outline;
    }

    HoldTouch {
        width: 100%;
        height: 100%;
        holdable: root.holdable;
        tapped => {
            root.pressed();
        }
        held => {
            root.held();
        }
    }
}

// One page of rows, with the bottom bar always on the screen edge. The
// hardware page buttons are handled in Rust, so this list does not also
// listen for arrow keys. Only the visible page gets a row. A hidden row
// would still build its text, rule, and hold timer.
export component PagedList inherits Rectangle {
    in property <[PagedLine]> lines;
    in property <int> per-page: 1;
    in-out property <int> page: 0;
    in property <bool> show-action: false;
    in property <bool> holdable: false;
    in property <image> action-icon: ChromeIcons.add;
    callback line-pressed(int);
    callback line-held(int);
    callback action-clicked();

    vertical-stretch: 1;
    property <int> page-size: Math.max(1, root.per-page);
    property <int> page-count: Math.max(1, Math.ceil(root.lines.length * 1.0 / root.page-size));

    changed page-count => {
        if (root.page >= root.page-count) {
            root.page = Math.max(0, root.page-count - 1);
        }
    }
    changed page => {
        if (root.page < 0) {
            root.page = 0;
        } else if (root.page >= root.page-count) {
            root.page = Math.max(0, root.page-count - 1);
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;

            for line[index] in root.lines: Rectangle {
                property <bool> shown:
                    index >= root.page * root.page-size && index < (root.page + 1) * root.page-size;
                height: shown ? InkMetrics.row : 0px;

                if shown: InkListRow {
                    width: 100%;
                    height: 100%;
                    label: line.label;
                    value: line.value;
                    selected: line.selected;
                    holdable: root.holdable;
                    pressed => {
                        root.line-pressed(index);
                    }
                    held => {
                        root.line-held(index);
                    }
                }
            }
        }

        InkBottomBar {
            height: InkMetrics.bottom-bar;
            label: "\{root.page + 1} / \{root.page-count}";
            previous-icon: ChromeIcons.chevron-backward;
            previous-enabled: root.page > 0;
            next-icon: ChromeIcons.chevron-forward;
            next-enabled: root.page + 1 < root.page-count;
            show-action: root.show-action;
            action-icon: root.action-icon;
            previous-clicked => {
                if (root.page > 0) {
                    root.page -= 1;
                }
            }
            next-clicked => {
                if (root.page + 1 < root.page-count) {
                    root.page += 1;
                }
            }
            action-clicked => {
                root.action-clicked();
            }
        }
    }
}

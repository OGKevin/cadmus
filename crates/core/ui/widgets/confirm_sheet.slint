import { TouchLabel } from "touch_label.slint";
import { MaterialPalette } from "ink/palette.slint";

// A question in a centered card. The page underneath stays. A tap
// outside the card dismisses; Cancel does the same; the filled button
// accepts.
export component ConfirmSheet inherits Rectangle {
    in property <string> message;
    in property <string> accept-label;
    callback dismissed();
    callback accepted();

    width: 100%;
    height: 100%;

    property <length> margin: 32px;
    property <length> inset: 28px;
    property <length> gap: 24px;
    property <length> frame: 3px;
    property <length> card-width: Math.min(840px, Math.max(280px, root.width - 2 * root.margin));

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismissed();
        }
    }

    Rectangle {
        x: Math.max(0px, (root.width - self.width) / 2);
        y: Math.max(0px, (root.height - self.height) / 2);
        width: root.card-width;
        // The message is measured at the card's width. A layout's
        // minimum height wraps at the longest word and makes the card
        // much taller than the text.
        height: root.inset + message.height + root.gap + buttons.height + root.inset;
        background: MaterialPalette.surface;
        border-width: root.frame;
        border-radius: 9px;
        border-color: MaterialPalette.on-surface;
        clip: true;

        // The card itself swallows taps, so only the backdrop closes it.
        TouchArea {
            width: 100%;
            height: 100%;
        }

        message := Text {
            x: root.inset;
            y: root.inset;
            width: parent.width - 2 * root.inset;
            text: root.message;
            font-size: 38px;
            wrap: word-wrap;
            color: MaterialPalette.on-surface;
        }

        buttons := HorizontalLayout {
            x: root.inset;
            y: message.y + message.height + root.gap;
            width: parent.width - 2 * root.inset;
            height: 84px;
            spacing: 16px;

            TouchLabel {
                horizontal-stretch: 1;
                height: 84px;
                border-width: 2px;
                border-color: MaterialPalette.on-surface;
                label: @tr("Cancel");
                clicked => {
                    root.dismissed();
                }
            }

            TouchLabel {
                horizontal-stretch: 1;
                height: 84px;
                background: MaterialPalette.primary;
                label: root.accept-label;
                label-color: MaterialPalette.on-primary;
                clicked => {
                    root.accepted();
                }
            }
        }
    }
}

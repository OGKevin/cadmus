import { ChromeIcons } from "../icons/icons.slint";
import { InkAppBar } from "ink/app_bar.slint";
import { InkMetrics } from "ink/metrics.slint";

// Back arrow and title, shared by the overlays that are not the choice sheet.
export component ScreenHeader inherits Rectangle {
    in property <string> heading;
    callback back-pressed();

    height: InkMetrics.app-bar;

    InkAppBar {
        width: 100%;
        height: 100%;
        title: root.heading;
        leading-icon: ChromeIcons.arrow-back;
        leading-clicked => {
            root.back-pressed();
        }
    }
}

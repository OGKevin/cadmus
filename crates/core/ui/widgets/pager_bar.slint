import { ChromeIcons } from "../icons/icons.slint";
import { InkBottomBar } from "ink/bottom_bar.slint";
import { InkMetrics } from "ink/metrics.slint";

// Previous, page label, next. The bar is always on screen. Disabled arrows
// stay in place when there is one page. The bar shows the page the list
// draws and asks the list to move it.
export component PagerBar inherits Rectangle {
    in property <int> page: 0;
    in property <int> page-count: 1;
    in property <bool> show-action: false;
    in property <image> action-icon: ChromeIcons.add;
    callback previous-clicked();
    callback next-clicked();
    callback action-clicked();

    out property <length> bar-height: InkMetrics.bottom-bar;
    height: root.bar-height;

    InkBottomBar {
        width: 100%;
        height: 100%;
        label: "\{root.page + 1} / \{root.page-count}";
        previous-icon: ChromeIcons.chevron-backward;
        previous-enabled: root.page > 0;
        next-icon: ChromeIcons.chevron-forward;
        next-enabled: root.page + 1 < root.page-count;
        show-action: root.show-action;
        action-icon: root.action-icon;

        previous-clicked => {
            root.previous-clicked();
        }
        next-clicked => {
            root.next-clicked();
        }
        action-clicked => {
            root.action-clicked();
        }
    }
}

import { ChromeIcons } from "../icons/icons.slint";
import { InkBottomBar } from "ink/bottom_bar.slint";
import { InkMetrics } from "ink/metrics.slint";

// Previous, page label, next. The bar is always on screen. Disabled arrows
// stay in place when there is one page. `external-paging` leaves the page
// in the caller's hands (a network list, for example).
export component PagerBar inherits Rectangle {
    in-out property <int> page;
    in property <int> page-count: 1;
    in property <bool> external-paging: false;
    in property <bool> can-previous: false;
    in property <bool> can-next: false;
    in property <string> page-label;
    in property <bool> show-action: false;
    in property <image> action-icon: ChromeIcons.add;
    callback previous-clicked();
    callback next-clicked();
    callback action-clicked();

    out property <length> bar-height: InkMetrics.bottom-bar;
    height: root.bar-height;

    InkBottomBar {
        width: 100%;
        height: 100%;
        label: root.external-paging ? root.page-label : "\{root.page + 1} / \{root.page-count}";
        previous-icon: ChromeIcons.chevron-backward;
        previous-enabled: root.external-paging ? root.can-previous : root.page > 0;
        next-icon: ChromeIcons.chevron-forward;
        next-enabled: root.external-paging ? root.can-next : root.page + 1 < root.page-count;
        show-action: root.show-action;
        action-icon: root.action-icon;

        previous-clicked => {
            if (root.external-paging) {
                root.previous-clicked();
            } else if (root.page > 0) {
                root.page -= 1;
            }
        }
        next-clicked => {
            if (root.external-paging) {
                root.next-clicked();
            } else if (root.page + 1 < root.page-count) {
                root.page += 1;
            }
        }
        action-clicked => {
            root.action-clicked();
        }
    }
}

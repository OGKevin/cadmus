import { InkMetrics } from "../widgets/ink/metrics.slint";

export component StartupWindow inherits Window {
    out property <string> message: @tr("Cadmus starting up…");
    // Cormorant, the face for the startup sentence. Tests that register one
    // font file override this family.
    in property <string> font-family: "Cormorant";

    background: #ffffff;

    Text {
        text: root.message;
        color: #1a1a1a;
        font-family: root.font-family;
        font-size: 38px * InkMetrics.dp;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 90%;
        height: 100%;
        x: (parent.width - self.width) / 2;
    }
}

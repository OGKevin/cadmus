export component StartupWindow inherits Window {
    out property <string> message: @tr("Cadmus starting up…");
    // Layout inside `new()` measures this text before Rust can set the family.
    in property <string> font-family: "Noto Sans";

    background: #ffffff;

    Text {
        text: root.message;
        color: #1a1a1a;
        font-family: root.font-family;
        font-size: 72px;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 90%;
        height: 100%;
        x: (parent.width - self.width) / 2;
    }
}

import { ChromeIcons } from "../icons/icons.slint";
import { EinkBar } from "../widgets/eink_bar.slint";
import { InkMetrics } from "../widgets/ink/metrics.slint";
import { MaterialPalette } from "../widgets/ink/palette.slint";
import { InkScaffold } from "../widgets/ink/scaffold.slint";
import { InkScreen } from "../widgets/ink/screen.slint";
import { InkWindow } from "../widgets/ink/window.slint";
import { PagedLine, PagedList } from "../widgets/paged_list.slint";
import { SharedOverlays } from "../widgets/overlays.slint";
import { StatusPanel } from "../widgets/status_panel.slint";

export enum OtaScreen {
    source,
    list,
    auth,
    progress,
}

// Check for Updates. The source menu and the install question are the shared
// overlays. The list, sign-in, and download progress are states of this window.
export component OtaWindow inherits InkWindow {
    in-out property <OtaScreen> screen: OtaScreen.source;
    in property <bool> loading: false;
    in property <bool> back-enabled: true;
    in property <[PagedLine]> lines;
    in property <bool> can-previous: false;
    in property <bool> can-next: false;
    in property <string> page-label;
    in property <string> auth-message;
    in property <string> auth-code;
    in property <string> progress-label;
    in property <float> progress: 0;
    in property <bool> progress-indeterminate: false;
    in-out property <int> geom-token: 0;
    in-out property <length> bar-x;
    in-out property <length> bar-y;
    in-out property <length> bar-width;
    in-out property <length> bar-height;
    in property <bool> progress-cancelable: true;

    callback back-pressed();
    callback line-pressed(int);
    callback refresh-clicked();
    callback previous-clicked();
    callback next-clicked();
    callback auth-cancel();
    callback progress-cancel();

    property <length> pad: 24px * InkMetrics.dp;
    property <length> reserved: InkMetrics.app-bar + InkMetrics.hairline + InkMetrics.bottom-bar;
    out property <int> per-page: Math.max(1, Math.floor((InkScreen.window-height - root.reserved) / InkMetrics.two-line-row));

    InkScaffold {
        width: 100%;
        height: 100%;
        title: @tr("Check for Updates");
        back-enabled: root.back-enabled;
        back-pressed => {
            root.back-pressed();
        }

        if root.screen == OtaScreen.list: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                width: 100%;
                height: 100%;

                if root.lines.length == 0 && !root.loading: Text {
                    text: @tr("No open pull requests");
                    font-size: InkMetrics.body;
                    color: MaterialPalette.on-surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                // The bar stays when the page is empty so refresh is still there.
                PagedList {
                    vertical-stretch: root.lines.length == 0 ? 0 : 1;
                    lines: root.lines;
                    per-page: root.per-page;
                    external-paging: true;
                    can-previous: root.can-previous;
                    can-next: root.can-next;
                    page-label: root.page-label;
                    show-action: true;
                    action-icon: ChromeIcons.refresh;
                    line-pressed(index) => {
                        root.line-pressed(index);
                    }
                    action-clicked => {
                        root.refresh-clicked();
                    }
                    previous-clicked => {
                        root.previous-clicked();
                    }
                    next-clicked => {
                        root.next-clicked();
                    }
                }
            }

            if root.loading: EinkBar {
                indeterminate: true;
                width: parent.width - 2 * root.pad;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.screen == OtaScreen.auth: StatusPanel {
            vertical-stretch: 1;
            message: root.auth-message;
            code: root.auth-code;
            show-cancel: true;
            cancel => {
                root.auth-cancel();
            }
        }

        if root.screen == OtaScreen.progress: StatusPanel {
            vertical-stretch: 1;
            message: root.progress-label;
            show-bar: true;
            progress: root.progress;
            progress-indeterminate: root.progress-indeterminate;
            show-cancel: root.progress-cancelable;
            geom-token: root.geom-token;
            bar-x <=> root.bar-x;
            bar-y <=> root.bar-y;
            bar-width <=> root.bar-width;
            bar-height <=> root.bar-height;
            cancel => {
                root.progress-cancel();
            }
        }
    }

    SharedOverlays {}
}

{
  "enums": [
    {
      "name": "Extension",
      "rust_name": "FileExtension",
      "doc": "A known file extension for documents Cadmus can import and open.\n\nThe serialized string (e.g. `\"epub\"`, `\"cbz\"`) is used as the TOML key in\nrefresh-rate-by-kind maps and as values in allowed/metadata/dithered kind sets.",
      "derives": [
        "Debug",
        "Copy",
        "Clone",
        "Eq",
        "PartialEq",
        "Ord",
        "PartialOrd",
        "Hash",
        "serde::Serialize",
        "serde::Deserialize"
      ],
      "attrs": ["serde(rename_all = \"lowercase\")"],
      "all_doc": "Returns all known file extensions.",
      "variants": [
        { "rust": "Cbr", "number": 1, "doc": "Comic book RAR archive." },
        { "rust": "Cbz", "number": 2, "doc": "Comic book ZIP archive." },
        {
          "rust": "Djvu",
          "number": 3,
          "doc": "DjVu document.",
          "attrs": ["serde(alias = \"djv\")"]
        },
        { "rust": "Epub", "number": 4, "doc": "EPUB ebook." },
        { "rust": "Fb2", "number": 5, "doc": "FictionBook document." },
        {
          "rust": "Html",
          "number": 6,
          "doc": "HTML document.",
          "attrs": ["serde(alias = \"htm\")"]
        },
        {
          "rust": "Jpeg",
          "number": 7,
          "doc": "JPEG image using the long extension."
        },
        {
          "rust": "Jpg",
          "number": 8,
          "doc": "JPEG image using the short extension."
        },
        { "rust": "Mobi", "number": 9, "doc": "Mobipocket ebook." },
        { "rust": "Oxps", "number": 10, "doc": "OpenXPS document." },
        { "rust": "Pdf", "number": 11, "doc": "PDF document." },
        { "rust": "Png", "number": 12, "doc": "PNG image." },
        { "rust": "Svg", "number": 13, "doc": "SVG image." },
        { "rust": "Txt", "number": 14, "doc": "Plain text document." },
        { "rust": "Webp", "number": 15, "doc": "WebP image." },
        { "rust": "Xps", "number": 16, "doc": "XPS document." }
      ]
    },

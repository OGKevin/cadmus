msgid "Eject and disconnect the USB cable."
msgstr ""

#: src/installation/index.md:60
msgid ""
"\\[!NOTE\\] Always name the file `KoboRoot.tgz` on the device, regardless of "
"which package you downloaded (e.g. `KoboRoot-nm.tgz` must be renamed)."

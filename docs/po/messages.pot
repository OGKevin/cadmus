#: src/time-sync.md:10
msgid "Detect your timezone based on your IP address."
msgstr ""

#: src/time-sync.md:11
msgid "Fetch the current time from an internet time server."
msgstr ""

#: src/time-sync.md:12
msgid "Update the system clock and hardware clock on your Kobo."
msgstr ""

#: src/time-sync.md:14
msgid "After syncing, the clock in the status bar updates immediately."
msgstr ""


msgstr ""

#: src/installation/ota.md:47
msgid "Latest development build (most recent changes)"
msgstr ""

#: src/installation/ota.md:48
msgid "**PR Build**"
msgstr ""

#: src/installation/ota.md:48
msgid "Test a specific pull request"
msgstr ""


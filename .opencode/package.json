{
  "name": "cadmus-opencode",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "format": "prettier --check \"plugins/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json",
    "format:fix": "prettier --write \"plugins/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.1",
    "@types/node": "^26.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
